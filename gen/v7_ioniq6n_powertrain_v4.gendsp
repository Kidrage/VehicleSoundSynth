{
  "patcher": {
    "appversion": {
      "architecture": "x64",
      "major": 8,
      "minor": 6,
      "modernui": 1,
      "revision": 5
    },
    "boxes": [
      {
        "box": {
          "code": "// V7 VERSIONED SOURCE: original source is retained in gen/.\nParam weight_balance(1, min=0, max=1);\nParam foundation(.70, min=0, max=1);\nParam reference_restore(1, min=0, max=1);\nParam accel_orders(0.30, min=0, max=1);\nParam rpm(650, min=0, max=10000);\nParam throttle(0, min=0, max=1);\nParam load(0, min=-1, max=1);\nParam accel(0, min=-1, max=1);\nParam engine_running(0, min=0, max=1);\nParam shift_cut(1, min=0, max=1);\nParam motor_order(0.72, min=0, max=1);\nParam body_pressure(0.86, min=0, max=1);\nParam cavity_structure(0.78, min=0, max=1);\nParam mechanical_texture(0.58, min=0, max=1);\nParam hf_edge(0.34, min=0, max=1);\nParam load_depth(0.82, min=0, max=1);\nParam release_mass(0.68, min=0, max=1);\nParam ready_bed(0.42, min=0, max=1);\nParam stereo_width(0.62, min=0, max=1);\nParam saturation(0.24, min=0, max=1);\nParam v7_enable(1, min=0, max=1);\nParam v7_core_db(-3, min=-12, max=3);\nParam v7_attack_ms(65, min=10, max=180);\nParam v7_release_ms(280, min=80, max=800);\nParam v7_pitch_relief(0.7, min=0, max=1);\nParam v7_lift_range_db(6, min=3, max=12);\nParam v7_weight_trim_db(-6, min=-12, max=0);\nParam v7_order2_db(0, min=-12, max=3);\nParam v7_order3_db(0, min=-12, max=3);\nHistory v7_tenv(0); History v7_lenv(0);\nv7_on = slide(v7_enable, samplerate*.04, samplerate*.04);\nv7_tt = clamp(throttle,0,1);\nv7_lt = abs(clamp(load,-1,1));\nv7_tk = exp(-1/(samplerate*.001*(v7_tt>v7_tenv ? v7_attack_ms : v7_release_ms)));\nv7_lk = exp(-1/(samplerate*.001*(v7_lt>v7_lenv ? v7_attack_ms : v7_release_ms)));\nv7_tenv = v7_tt+(v7_tenv-v7_tt)*v7_tk;\nv7_lenv = v7_lt+(v7_lenv-v7_lt)*v7_lk;\nv7_core = pow(10,slide(v7_core_db,samplerate*.03,samplerate*.03)*v7_on/20);\nv7_order2 = pow(10,slide(v7_order2_db,samplerate*.03,samplerate*.03)*v7_on/20);\nv7_order3 = pow(10,slide(v7_order3_db,samplerate*.03,samplerate*.03)*v7_on/20);\n// V4: balance the dominant root BEFORE common acoustic filtering.\n\n\nHistory wb_slow(0); History wb_fast(0); History wb_rslow(0); History wb_x1(0); History wb_x2(0);\nHistory wb_a1(0); History wb_a2(0); History wb_b1(0); History wb_b2(0); History wb_c1(0); History wb_c2(0);\n// V3 reference fit: render-only RPM, never published as vehicle telemetry.\n\nHistory repair_launch_env(0);\n\nHistory detail_env(0);\n// IONIQ 6 N mode-neutral electric order exciter; BEAP owns the tunable acoustic structure.\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nr = slide(clamp(rpm, 0, 10000), 900, 1500);\nt_fast = (slide(clamp(throttle, 0, 1), 60, 180))*(1-v7_on)+(v7_tenv)*v7_on;\nl_fast = (slide(abs(clamp(load, -1, 1)), 60, 180))*(1-v7_on)+(v7_lenv)*v7_on;\nl_slow = (slide(abs(clamp(load, -1, 1)), 120, 450))*(1-v7_on)+(v7_lenv)*v7_on;\nrelease = slide(max(-clamp(accel, -1, 1), 0), 120, 520);\nrun = slide(clamp(engine_running, 0, 1), 700, 1700);\ncut = slide(clamp(shift_cut, 0, 1), 80, 260);\nrepair_mix = slide(clamp(reference_restore,0,1),samplerate*.080,samplerate*.080);\nrepair_d = max(r-2600,0);\nrepair_compress = .5*(repair_d < 1600 ? repair_d*repair_d/3200 : repair_d-800);\nrepair_rpm = r-repair_mix*repair_compress*(1-v7_on*v7_pitch_relief);\nroot = clamp(52 + repair_rpm * 0.047, 52, 522);\n// Activation (1450) and ready/idle protected. Reuse existing two partials.\nrepair_up = clamp((r-1900)/700,0,1);\nrepair_down = clamp((4500-r)/1500,0,1);\nrepair_window = repair_up*repair_up*(3-2*repair_up)*repair_down*repair_down*(3-2*repair_down);\nrepair_launch_target = repair_window*sqrt(clamp(throttle,0,1)*clamp(load,0,1))*clamp(accel,0,1);\nrepair_tau = repair_launch_target > repair_launch_env ? .065 : .220;\nrepair_k = exp(-1/(samplerate*repair_tau));\nrepair_launch_env = repair_launch_target+(repair_launch_env-repair_launch_target)*repair_k;\nrepair_launch = repair_mix*repair_launch_env*repair_up*repair_up*(3-2*repair_up);\ndrive = clamp(0.11 + load_depth * (0.30*t_fast + 0.22*l_fast) + 0.10*l_slow, 0.08, 0.72);\nv7_runblend = clamp((r-1600)/1200,0,1);\nv7_runblend = v7_on*v7_runblend*v7_runblend*(3-2*v7_runblend);\nv7_drive_peak = clamp(.21+.52*load_depth,.08,.72);\nv7_drive = v7_drive_peak*pow(10,-v7_lift_range_db*(1-clamp(.5*v7_tenv+.5*v7_lenv,0,1))/20);\ndrive = drive+(v7_drive-drive)*v7_runblend;\n// Positive acceleration only. No shift/vehicle-state feedback.\ndetail_progress = clamp((r-1200)/1800,0,1);\ndetail_window = detail_progress*detail_progress*(3-2*detail_progress);\ndetail_target = clamp(accel,0,1)*clamp(throttle,0,1)*clamp(load,0,1)*detail_window;\ndetail_tau = detail_target > detail_env ? .080 : .180;\ndetail_k = exp(-1/(samplerate*detail_tau));\ndetail_env = detail_target+(detail_env-detail_target)*detail_k;\ndetail_amount = slide(clamp(accel_orders,0,1),samplerate*.025,samplerate*.025)*detail_env;\nwb_control = slide(clamp(weight_balance,0,1),samplerate*.08,samplerate*.08);\nwb_progress = clamp((r-1600)/1200,0,1);\nwb_active = wb_control*wb_progress*wb_progress*(3-2*wb_progress);\nwb_foundation = slide(clamp(foundation,0,1),samplerate*.08,samplerate*.08);\norder1 = v7_core * cycle(root) * (0.50 + 0.20*motor_order)*(1-.62*wb_active);\norder2 = (cycle(clamp(root*1.5, 78, 920)) * (0.13 + 0.12*motor_order)*(1+.50*detail_amount)*(1+.28*repair_launch))*v7_order2;\norder3 = (cycle(clamp(root*2.25, 118, 1450)) * (0.055 + 0.09*cavity_structure)*(1+.80*detail_amount)*(1+.40*repair_launch))*v7_order3;\nbody = (cycle(clamp(root*0.5, 28, 260))*0.24 + cycle(clamp(root*0.75, 40, 390))*0.13) * body_pressure;\ncavity_l = (cycle(clamp(root*3.05, 165, 2100))*0.058 + cycle(clamp(root*4.10, 220, 2850))*0.032) * cavity_structure;\ncavity_r = (cycle(clamp(root*2.98, 162, 2050))*0.058 + cycle(clamp(root*4.18, 225, 2900))*0.032) * cavity_structure;\nmechanical_l = (cycle(clamp(root*5.37, 290, 4300))*0.040 + cycle(clamp(root*7.13, 385, 5700))*0.018) * mechanical_texture;\nmechanical_r = (cycle(clamp(root*5.61, 300, 4450))*0.040 + cycle(clamp(root*6.87, 370, 5550))*0.018) * mechanical_texture;\nedge_l = (cycle(clamp(root*9.7, 520, 6100))*0.018 + cycle(clamp(root*12.9, 690, 7600))*0.008) * hf_edge * (0.25+0.75*t_fast);\nedge_r = (cycle(clamp(root*10.1, 540, 6300))*0.018 + cycle(clamp(root*12.4, 670, 7400))*0.008) * hf_edge * (0.25+0.75*t_fast);\nready_weight = 1-clamp((r-650)/1250,0,1);\nready = (cycle(55)*0.10 + cycle(110)*0.045 + cycle(220)*0.018) * ready_bed * ready_weight * (1-0.55*t_fast);\nrelease_body = (cycle(clamp(root*0.62,32,320))*0.075 + cycle(clamp(root*1.24,65,640))*0.035) * release * release_mass;\ncenter = (order1+order2+order3+body+ready+release_body) * drive;\nside_l = (cavity_l+mechanical_l+edge_l) * drive * (0.28+0.42*stereo_width);\nside_r = (cavity_r+mechanical_r+edge_r) * drive * (0.28+0.42*stereo_width);\ngain = run*cut;\nsat = 1+saturation*0.75;\nout1 = tanh((center+side_l)*gain*sat)/sat;\nout2 = tanh((center+side_r)*gain*sat)/sat;\nwb_load = clamp(.45*t_fast+.55*l_slow,0,1);\nwb_kf = exp(-1/(samplerate*.055));\nwb_ks = exp(-1/(samplerate*(wb_load>wb_slow ? .120 : .550)));\nwb_fast = wb_load+(wb_fast-wb_load)*wb_kf;\nwb_slow = wb_load+(wb_slow-wb_load)*wb_ks;\nwb_rtarget = clamp((r-1600)/6400,0,1);\nwb_rslow = wb_rtarget+(wb_rslow-wb_rtarget)*exp(-1/(samplerate*.650));\n// Small slow frequency movement: mass does not leave its register at high RPM.\nwb_fa = 61 + 4*wb_slow + 2*wb_rslow;\nwb_fb = 87 + 5*wb_slow + 3*wb_rslow;\nwb_wa = cycle(wb_fa); wb_wb = cycle(wb_fb);\n// Distributed finite pressure partials, not a loud pair of fundamental sines.\n// Chebyshev polynomials reuse each continuous oscillator phase; no DC term.\nwb_a_h2=2*wb_wa*wb_wa-1;\nwb_a_h3=4*wb_wa*wb_wa*wb_wa-3*wb_wa;\nwb_a_h4=8*pow(wb_wa,4)-8*wb_wa*wb_wa+1;\nwb_a_h5=16*pow(wb_wa,5)-20*pow(wb_wa,3)+5*wb_wa;\nwb_b_h2=2*wb_wb*wb_wb-1;\nwb_b_h3=4*wb_wb*wb_wb*wb_wb-3*wb_wb;\nwb_b_h4=8*pow(wb_wb,4)-8*wb_wb*wb_wb+1;\nwb_b_h5=16*pow(wb_wb,5)-20*pow(wb_wb,3)+5*wb_wb;\nwb_pa=.15*wb_wa+.24*wb_a_h2+.20*wb_a_h3+.14*wb_a_h4+.09*wb_a_h5;\nwb_pb=.12*wb_wb+.22*wb_b_h2+.18*wb_b_h3+.14*wb_b_h4+.10*wb_b_h5;\nwb_exciter = wb_pa*.62+wb_pb*.56;\nwb_body_hz = 144 + 5*wb_slow + 3*wb_rslow;\nwb_cavity_hz = 252 + 8*wb_slow + 5*wb_rslow;\nwb_upper_hz = 404 + 10*wb_slow + 7*wb_rslow;\nwb_aw = 6.283185307179586*wb_body_hz/samplerate;\n// Constant-peak bandpass biquad (RBJ): zeros at DC and Nyquist.\nwb_aalpha = sin(wb_aw)/(2*1.15);\nwb_anorm = 1/(1+wb_aalpha);\nwb_a = wb_aalpha*wb_anorm*(wb_exciter-wb_x2) + 2*cos(wb_aw)*wb_anorm*wb_a1-(1-wb_aalpha)*wb_anorm*wb_a2;\nwb_a2 = wb_a1; wb_a1 = wb_a;\nwb_bw = 6.283185307179586*wb_cavity_hz/samplerate;\n// Constant-peak bandpass biquad (RBJ): zeros at DC and Nyquist.\nwb_balpha = sin(wb_bw)/(2*1.3);\nwb_bnorm = 1/(1+wb_balpha);\nwb_b = wb_balpha*wb_bnorm*(wb_exciter-wb_x2) + 2*cos(wb_bw)*wb_bnorm*wb_b1-(1-wb_balpha)*wb_bnorm*wb_b2;\nwb_b2 = wb_b1; wb_b1 = wb_b;\nwb_cw = 6.283185307179586*wb_upper_hz/samplerate;\n// Constant-peak bandpass biquad (RBJ): zeros at DC and Nyquist.\nwb_calpha = sin(wb_cw)/(2*1.25);\nwb_cnorm = 1/(1+wb_calpha);\nwb_c = wb_calpha*wb_cnorm*(wb_exciter-wb_x2) + 2*cos(wb_cw)*wb_cnorm*wb_c1-(1-wb_calpha)*wb_cnorm*wb_c2;\nwb_c2 = wb_c1; wb_c1 = wb_c;\nwb_x2=wb_x1; wb_x1=wb_exciter;\nwb_body_signal = (wb_a*.85+wb_b*.28)*(.24+.40*wb_slow);\nwb_cavity_signal = (wb_b*.58+wb_c*.48)*(.16+.32*wb_slow+.08*wb_fast);\n\n// Separate outputs enter the actual Body/Cavity filter inputs, not master EQ.\n// Both get the SAME Main DNA gain, mixer mutes and VCA as the tonal paths.\nwb_gain = wb_active*wb_foundation*run*(.82+.18*cut);\nout3 = wb_body_signal*body_pressure*wb_gain*1.8;\nout4 = wb_cavity_signal*cavity_structure*wb_gain*1.8;\n\nout3 = out3*pow(10,v7_weight_trim_db*v7_on/20);\nout4 = out4*pow(10,v7_weight_trim_db*v7_on/20);\n\nout5=repair_rpm; out6=root; // read-only renderer telemetry\n",
          "id": "obj-1",
