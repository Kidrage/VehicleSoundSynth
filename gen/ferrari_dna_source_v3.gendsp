    "boxes": [
      {
        "box": {
          "code": "Param v3_aggression(0.5, min=0, max=1);\nParam v3_body(0.5, min=0, max=1);\nParam v3_character(0.5, min=0, max=1);\nParam v3_softness(0.5, min=0, max=1);\nParam v3_release_mass(0.5, min=0, max=1);\nParam v3_width(0.5, min=0, max=1);\nParam v3_load_response(0.5, min=0, max=1);\nHistory v3_env0(0);\nHistory v3_env1(0);\nHistory v3_env2(0);\nParam rpm(740, min=0, max=10000);\nParam throttle(0, min=0, max=1);\nParam load(0, min=-1, max=1);\nParam engine_running(0, min=0, max=1);\nParam combustion_gain(0, min=0, max=1);\nParam shift_cut(1, min=0, max=1);\nr = slide(rpm, samplerate*0.013, samplerate*0.021);\nv3_fire = r/12;\nv3_quarter_phase = phasor(v3_fire*.25);\nv3_phase = wrap(v3_quarter_phase*4,0,1);\nv3_legacy_l = 0;\nv3_legacy_r = 0;\nv3_blend = 1;\n// Smooth parameter movement and asymmetric sample-rate-independent envelopes.\nv3_effort = max(clamp(throttle,0,1),max(load,0));\nv3_agg = slide(v3_aggression,samplerate*.025,samplerate*.025);\nv3_mass = slide(v3_body,samplerate*.035,samplerate*.035);\nv3_char = slide(v3_character,samplerate*.035,samplerate*.035);\nv3_soft = slide(v3_softness,samplerate*.035,samplerate*.035);\nv3_response = slide(v3_load_response,samplerate*.035,samplerate*.035);\nv3_gate = slide(engine_running*combustion_gain*shift_cut,samplerate*.009,samplerate*.036);\nv3_tau0 = v3_effort > v3_env0 ? 32.5 : 90+v3_release_mass*70;\nv3_k0 = exp(-1/(samplerate*.001*v3_tau0));\nv3_env0 = v3_effort+(v3_env0-v3_effort)*v3_k0;\nv3_tau1 = v3_effort > v3_env1 ? 70 : 180+v3_release_mass*120;\nv3_k1 = exp(-1/(samplerate*.001*v3_tau1));\nv3_env1 = v3_effort+(v3_env1-v3_effort)*v3_k1;\nv3_tau2 = v3_effort > v3_env2 ? 20 : 40+v3_release_mass*50;\nv3_k2 = exp(-1/(samplerate*.001*v3_tau2));\nv3_env2 = v3_effort+(v3_env2-v3_effort)*v3_k2;\nv3_h1 = cos(v3_phase*6.283185307179586*1)*clamp((samplerate*.45-v3_fire*1)/(samplerate*.05),0,1);\nv3_h2 = cos(v3_phase*6.283185307179586*2)*clamp((samplerate*.45-v3_fire*2)/(samplerate*.05),0,1);\nv3_h3 = cos(v3_phase*6.283185307179586*3)*clamp((samplerate*.45-v3_fire*3)/(samplerate*.05),0,1);\nv3_h4 = cos(v3_phase*6.283185307179586*4)*clamp((samplerate*.45-v3_fire*4)/(samplerate*.05),0,1);\nv3_h5 = cos(v3_phase*6.283185307179586*5)*clamp((samplerate*.45-v3_fire*5)/(samplerate*.05),0,1);\nv3_h6 = cos(v3_phase*6.283185307179586*6)*clamp((samplerate*.45-v3_fire*6)/(samplerate*.05),0,1);\nv3_h7 = cos(v3_phase*6.283185307179586*7)*clamp((samplerate*.45-v3_fire*7)/(samplerate*.05),0,1);\nv3_h8 = cos(v3_phase*6.283185307179586*8)*clamp((samplerate*.45-v3_fire*8)/(samplerate*.05),0,1);\nv3_h9 = cos(v3_phase*6.283185307179586*9)*clamp((samplerate*.45-v3_fire*9)/(samplerate*.05),0,1);\nv3_h10 = cos(v3_phase*6.283185307179586*10)*clamp((samplerate*.45-v3_fire*10)/(samplerate*.05),0,1);\nv3_h11 = cos(v3_phase*6.283185307179586*11)*clamp((samplerate*.45-v3_fire*11)/(samplerate*.05),0,1);\nv3_h12 = cos(v3_phase*6.283185307179586*12)*clamp((samplerate*.45-v3_fire*12)/(samplerate*.05),0,1);\nv3_open = clamp(.12+.48*v3_agg+v3_env0*(.15+.25*v3_response),0,1);\nv3_pressure = v3_h1*.4921875+v3_h2*(.12+.16125*v3_open)+v3_h3*.10546875*v3_open+v3_h4*.0234375*v3_open+v3_h5*.001953125*v3_open;\n// Body has its OWN deterministic low-frequency carrier; filtering a 500-Hz\n// pulse through a 150-Hz lowpass cannot create the missing fundamental.\nv3_body_hz = 48+r*0.018;\nv3_body_phase = phasor(v3_body_hz);\nv3_body_wave = cos(v3_body_phase*6.283185307179586)*.70\n + cos(v3_body_phase*12.566370614359172)*.22\n + cos(v3_body_phase*18.84955592153876)*.08;\nv3_suborder = cycle(v3_fire*.5)*.18;\nv3_w1a = clamp(1-abs(v3_fire*1-320-r*.012)/(240+120*v3_open+100*v3_char),0,1);\nv3_w1b = clamp(1-abs(v3_fire*1-700-r*.018)/(360+140*v3_open+100*v3_char),0,1);\nv3_w2a = clamp(1-abs(v3_fire*2-320-r*.012)/(240+120*v3_open+100*v3_char),0,1);\nv3_w2b = clamp(1-abs(v3_fire*2-700-r*.018)/(360+140*v3_open+100*v3_char),0,1);\nv3_w3a = clamp(1-abs(v3_fire*3-320-r*.012)/(240+120*v3_open+100*v3_char),0,1);\nv3_w3b = clamp(1-abs(v3_fire*3-700-r*.018)/(360+140*v3_open+100*v3_char),0,1);\nv3_w4a = clamp(1-abs(v3_fire*4-320-r*.012)/(240+120*v3_open+100*v3_char),0,1);\nv3_w4b = clamp(1-abs(v3_fire*4-700-r*.018)/(360+140*v3_open+100*v3_char),0,1);\nv3_w5a = clamp(1-abs(v3_fire*5-320-r*.012)/(240+120*v3_open+100*v3_char),0,1);\nv3_w5b = clamp(1-abs(v3_fire*5-700-r*.018)/(360+140*v3_open+100*v3_char),0,1);\nv3_w6a = clamp(1-abs(v3_fire*6-320-r*.012)/(240+120*v3_open+100*v3_char),0,1);\nv3_w6b = clamp(1-abs(v3_fire*6-700-r*.018)/(360+140*v3_open+100*v3_char),0,1);\nv3_w7a = clamp(1-abs(v3_fire*7-320-r*.012)/(240+120*v3_open+100*v3_char),0,1);\nv3_w7b = clamp(1-abs(v3_fire*7-700-r*.018)/(360+140*v3_open+100*v3_char),0,1);\nv3_w8a = clamp(1-abs(v3_fire*8-320-r*.012)/(240+120*v3_open+100*v3_char),0,1);\nv3_w8b = clamp(1-abs(v3_fire*8-700-r*.018)/(360+140*v3_open+100*v3_char),0,1);\nv3_cavity = v3_h1*(v3_w1a*v3_w1a*(3-2*v3_w1a)*.65+v3_w1b*v3_w1b*(3-2*v3_w1b)*.35)/1.00000000+v3_h2*(v3_w2a*v3_w2a*(3-2*v3_w2a)*.65+v3_w2b*v3_w2b*(3-2*v3_w2b)*.35)/1.62450479+v3_h3*(v3_w3a*v3_w3a*(3-2*v3_w3a)*.65+v3_w3b*v3_w3b*(3-2*v3_w3b)*.35)/2.15766928+v3_h4*(v3_w4a*v3_w4a*(3-2*v3_w4a)*.65+v3_w4b*v3_w4b*(3-2*v3_w4b)*.35)/2.63901582+v3_h5*(v3_w5a*v3_w5a*(3-2*v3_w5a)*.65+v3_w5b*v3_w5b*(3-2*v3_w5b)*.35)/3.08516931+v3_h6*(v3_w6a*v3_w6a*(3-2*v3_w6a)*.65+v3_w6b*v3_w6b*(3-2*v3_w6b)*.35)/3.50514409+v3_h7*(v3_w7a*v3_w7a*(3-2*v3_w7a)*.65+v3_w7b*v3_w7b*(3-2*v3_w7b)*.35)/3.90452878+v3_h8*(v3_w8a*v3_w8a*(3-2*v3_w8a)*.65+v3_w8b*v3_w8b*(3-2*v3_w8b)*.35)/4.28709385;\nv3_pm_index = (.03+.12*v3_char)*(.4+.6*v3_open);\nv3_pm1 = sin(v3_quarter_phase*6.283185307179586*6 + v3_pm_index*sin(v3_quarter_phase*6.283185307179586*2));\nv3_pm2 = sin(v3_quarter_phase*6.283185307179586*9 + v3_pm_index*sin(v3_quarter_phase*6.283185307179586*3));\nv3_cavity = v3_cavity + v3_pm1*.09 + v3_pm2*.065;\n// Shallow, local midrange drive. No whole-bus square-wave saturation.\nv3_local_drive = 1+v3_agg*.65;\nv3_character_wave = tanh(v3_cavity*v3_local_drive)/v3_local_drive;\nv3_upper_wave = (v3_h4*.48+v3_h5*.28+v3_h6*.16+v3_h8*.08)*(1-.82*v3_soft);\nout1 = v3_pressure*.18*(.55+(.20+.5*v3_response)*v3_env0)*v3_gate;\nout2 = (v3_body_wave+v3_suborder+v3_pressure*.10)*.18*(.45+(.25+.6*v3_response)*v3_env1)*(.5+v3_mass)*v3_gate;\nout3 = v3_character_wave*.20*(.35+(.30+.7*v3_response)*v3_env0)*(.5+v3_char)*v3_gate;\nout4 = v3_upper_wave*.16*v3_env2*v3_gate;\nout5 = v3_legacy_l;\nout6 = v3_legacy_r;\nout7 = v3_blend;\n// Random residuals split BEFORE any DNA mixing, gain or saturation.\n// The shared cadence excites them; no second engine and no mixed-DNA tap.\nv3_peak = pow(max(v3_pressure,0)/.905,2);\nout8 = noise()*v3_peak*(.40+.60*v3_env1)*v3_gate;\nout9 = noise()*v3_peak*(.3+.7*v3_env0)*v3_gate;\nout10 = noise()*(.2+abs(v3_pressure))*(.15+.85*v3_env2)*v3_gate;",
