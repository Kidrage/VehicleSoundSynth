{
  "patcher": {
    "appversion": {
      "architecture": "x64",
      "major": 8,
      "minor": 6,
      "modernui": 1,
      "revision": 5
    },
    "boxes": [
      {
        "box": {
          "code": "// V2 PARAMETERS START\nParam running_body(0.88, min=0, max=1);\nParam running_cavity(0.66, min=0, max=1);\nParam hf_softness(0.88, min=0, max=1);\nParam release_mass(0.76, min=0, max=1);\nHistory v2_m0_1(0);\nHistory v2_m0_2(0);\nHistory v2_m1_1(0);\nHistory v2_m1_2(0);\nHistory v2_m2_1(0);\nHistory v2_m2_2(0);\nHistory v2_m3_1(0);\nHistory v2_m3_2(0);\nHistory v2_exc_1(0);\nHistory v2_exc_2(0);\nHistory v2_side_low(0);\nHistory v2_hf_l1(0);\nHistory v2_hf_l2(0);\nHistory v2_hf_r1(0);\nHistory v2_hf_r2(0);\n// V2 PARAMETERS END\n// Procedural V12: smooth independent six-cylinder banks with high-order air.\nParam rpm(780, min=0, max=10000);\nParam throttle(0, min=0, max=1);\nParam load(0, min=-1, max=1);\nParam accel(0, min=-1, max=1);\nParam aggression(0.62, min=0, max=1);\nParam brightness(0.78, min=0, max=1);\nParam body(0.72, min=0, max=1);\nParam texture(0.52, min=0, max=1);\nParam engine_running(0, min=0, max=1);\nParam combustion_gain(0, min=0, max=1);\nParam shift_cut(1, min=0, max=1);\nParam air_detail(0.68, min=0, max=1);\nParam cycle_irregularity(0.34, min=0, max=1);\nParam stereo_width(0.64, min=0, max=1);\nParam throttle_loudness_depth(4.5, min=0, max=8);\nParam saturation(0.28, min=0, max=1);\nParam idle_level(0.78, min=0, max=1);\nParam idle_body(0.86, min=0, max=1);\nParam idle_metal(0.58, min=0, max=1);\nParam idle_irregularity(0.18, min=0, max=1);\nParam idle_air(0.34, min=0, max=1);\nParam idle_width(0.52, min=0, max=1);\nParam combustion_pulse(0.80, min=0, max=1);\nParam intake_detail(0.68, min=0, max=1);\nParam exhaust_detail(0.62, min=0, max=1);\nParam residual_detail(0.64, min=0, max=1);\nr = slide(clamp(rpm, 0, 10000), 700, 1100);\nt = slide(clamp(throttle, 0, 1), 420, 850);\nl = max(clamp(load, -1, 1), 0);\nmotion = slide(clamp(accel, -1, 1), 320, 900);\naccel_drive = max(motion, 0);\ndecel_drive = max(-motion, 0);\nrun = slide(clamp(engine_running * combustion_gain * shift_cut, 0, 1), 480, 1900);\nspeedmix = clamp((r - 780) / 8220, 0, 1);\nidle_weight = 1 - clamp((r - 780) / 1800, 0, 1);\ncrank = clamp(r / 60, 6, 170);\ncycle_variation = cycle(crank * 0.5) * (0.004 + cycle_irregularity * 0.016) + cycle(crank * 1.5) * cycle_irregularity * 0.006;\nbank_fire = clamp(crank * 3 * (1 + cycle_variation), 18, 525);\nfire = bank_fire * 2;\nphase_l = phasor(bank_fire);\nphase_r = phase_l + 0.5;\nphase_r = phase_r - floor(phase_r);\npulse_l = pow(0.5 + 0.5 * cos(phase_l * 6.283185307179586), 4) - 0.2734375;\npulse_r = pow(0.5 + 0.5 * cos(phase_r * 6.283185307179586), 4) - 0.2734375;\nthrottle_gain = pow(10, (t * throttle_loudness_depth) / 20);\ntone_t = 0.62 + t * 0.38;\nbody_t = 1 - t * 0.14;\na = clamp((0.205 + body * 0.050 + l * 0.040 + accel_drive * 0.022 - decel_drive * 0.016) * throttle_gain, 0, 0.54) * run;\ncylinder_l = 0.97 + cycle(crank * 0.5) * (0.018 + cycle_irregularity * 0.030) + cycle(crank * 1.5) * 0.012;\ncylinder_r = 0.97 + cycle(crank * 0.48) * (0.018 + cycle_irregularity * 0.030) + cycle(crank * 1.53) * 0.012;\nlegacy_idle_body = (cycle(clamp(crank * 2.6, 28, 260)) * 0.040 + cycle(clamp(crank * 3.8, 38, 420)) * 0.024) * body * idle_weight;\ncrankcase_body = legacy_idle_body;\nmanifold_l = cycle(clamp(fire * 0.42, 32, 950)) * (0.018 + l * 0.020) * (0.65 + idle_weight * 0.35);\nmanifold_r = cycle(clamp(fire * 0.445, 34, 1000)) * (0.018 + l * 0.020) * (0.65 + idle_weight * 0.35);\nmanifold = (manifold_l + manifold_r) * 0.5;\nshared_low = cycle(clamp(fire * 0.5, 24, 520)) * (0.062 + body * 0.050) * (1-speedmix*0.55) + legacy_idle_body;\norders_l = cycle(fire) * 0.17 + cycle(clamp(fire * 2.0, 45, 3200)) * (0.10 + brightness * 0.10) + cycle(clamp(fire * 3.0, 55, 5200)) * (0.06 + texture * 0.07);\norders_r = cycle(fire) * 0.165 + cycle(clamp(fire * 2.0, 45, 3200)) * (0.096 + brightness * 0.104) + cycle(clamp(fire * 3.0, 55, 5200)) * (0.064 + texture * 0.066);\nbright_l = (cycle(clamp(fire * 4.11, 90, 8000)) * 0.050 + cycle(clamp(fire * 6.17, 130, 12000)) * 0.026) * air_detail * (0.30 + speedmix * 0.70) * tone_t;\nbright_r = (cycle(clamp(fire * 3.89, 85, 7700)) * 0.050 + cycle(clamp(fire * 5.83, 125, 11800)) * 0.026) * air_detail * (0.30 + speedmix * 0.70) * tone_t;\nintake_l = cycle(clamp(fire * 1.49, 45, 2500)) * intake_detail * (0.016 + t * 0.024 + accel_drive * 0.030);\nintake_r = cycle(clamp(fire * 1.53, 45, 2600)) * intake_detail * (0.016 + t * 0.024 + accel_drive * 0.030);\nexhaust_l = cycle(clamp(fire * 0.73, 32, 1300)) * exhaust_detail * (t * 0.024 + accel_drive * 0.026 + decel_drive * 0.026);\nexhaust_r = cycle(clamp(fire * 0.77, 34, 1380)) * exhaust_detail * (t * 0.024 + accel_drive * 0.026 + decel_drive * 0.026);\nresidual_l = (cycle(clamp(fire * 1.33, 40, 2200)) * 0.042 + cycle(clamp(fire * 2.17, 65, 4200)) * 0.026) * abs(pulse_l) * residual_detail;\nresidual_r = (cycle(clamp(fire * 1.39, 42, 2300)) * 0.042 + cycle(clamp(fire * 2.11, 65, 4100)) * 0.026) * abs(pulse_r) * residual_detail;\nbank_l = pulse_l * cylinder_l * (0.40 + combustion_pulse * 0.22);\nbank_r = pulse_r * cylinder_r * (0.40 + combustion_pulse * 0.22);\nbank_mid = (bank_l + bank_r) * 0.5;\nbank_side = (bank_l - bank_r) * 0.5;\nbank_spread = 0.26 + stereo_width * 0.30;\nside_gain = 0.34 + stereo_width * 0.38;\nidle_energy_variation = 1 + cycle(crank * 0.31) * idle_irregularity * 0.026 + cycle(crank * 0.61) * idle_irregularity * 0.012;\nidle_modal = (cycle(fire * 0.5) * 0.105 + cycle(fire) * 0.118 + cycle(fire * 2) * 0.070 + cycle(fire * 3) * 0.038) * idle_body;\nidle_intake_structure = (cycle(fire * 1.5) * 0.044 + cycle(fire * 2.5) * 0.030) * (0.58 + idle_metal * 0.42);\nidle_metal_side = (bank_side * 0.105 + cycle(fire * 7.0) * abs(bank_mid) * 0.027 + cycle(fire * 9.0) * abs(bank_mid) * 0.016) * idle_metal;\nidle_air_side = (cycle(fire * 11.0) * 0.013 + cycle(fire * 15.0) * 0.007) * abs(bank_mid) * idle_air;\nidle_gain = idle_level * idle_weight * run * (1 - t * 0.28);\nidle_center = (idle_modal + idle_intake_structure) * idle_gain * idle_energy_variation;\nidle_side = (idle_metal_side + idle_air_side) * idle_gain * idle_width;\nleft_drive = ((shared_low + bank_mid) * body_t + bank_side * bank_spread + (manifold_l + orders_l + bright_l + intake_l + exhaust_l + residual_l) * side_gain) * a * (0.86 + aggression * 0.14) + idle_center + idle_side;\nright_drive = ((shared_low + bank_mid) * body_t - bank_side * bank_spread + (manifold_r + orders_r + bright_r + intake_r + exhaust_r + residual_r) * side_gain) * a * (0.86 + aggression * 0.14) + idle_center - idle_side;\nsat_drive = 1 + saturation * 0.85;\n// V2 RUNNING START\n// Fixed-RPM pedal moves affect pressure, cavity and release, never cadence.\nv2_progress = clamp((r - 1200) / 1800, 0, 1);\nv2_blend = v2_progress * v2_progress * (3 - 2 * v2_progress);\nv2_pedal = slide(clamp(throttle, 0, 1), 85, 190);\nv2_load_fast = slide(l, 110, 290);\nv2_body_env = slide(max(v2_pedal, v2_load_fast), 730, 1800 + release_mass * 12000);\nv2_edge_env = slide(max(v2_pedal, v2_load_fast), 120, 580);\nv2_lift = max(v2_body_env - v2_edge_env, 0);\nv2_pressure = (pulse_l * cylinder_l * 0.525 + pulse_r * cylinder_r * 0.475) * (0.75 + combustion_pulse * 0.80);\nv2_pressure = v2_pressure * (0.86 + v2_load_fast * 0.14 + abs(pulse_l) * texture * 0.18);\nv2_exc_diff = v2_pressure - v2_exc_2;\nv2_freq0 = 130 + r * 0.01;\nv2_rad0 = exp(-3.141592653589793 * v2_freq0 / (1.1 * samplerate));\nv2_modal0 = (1 - v2_rad0) * v2_exc_diff + 2 * v2_rad0 * cos(6.283185307179586 * v2_freq0 / samplerate) * v2_m0_1 - v2_rad0 * v2_rad0 * v2_m0_2;\nv2_m0_2 = v2_m0_1;\nv2_m0_1 = v2_modal0;\nv2_freq1 = 210 + r * 0.012;\nv2_rad1 = exp(-3.141592653589793 * v2_freq1 / (1.2 * samplerate));\nv2_modal1 = (1 - v2_rad1) * v2_exc_diff + 2 * v2_rad1 * cos(6.283185307179586 * v2_freq1 / samplerate) * v2_m1_1 - v2_rad1 * v2_rad1 * v2_m1_2;\nv2_m1_2 = v2_m1_1;\nv2_m1_1 = v2_modal1;\nv2_freq2 = 325 + r * 0.014;\nv2_rad2 = exp(-3.141592653589793 * v2_freq2 / (1.15 * samplerate));\nv2_modal2 = (1 - v2_rad2) * v2_exc_diff + 2 * v2_rad2 * cos(6.283185307179586 * v2_freq2 / samplerate) * v2_m2_1 - v2_rad2 * v2_rad2 * v2_m2_2;\nv2_m2_2 = v2_m2_1;\nv2_m2_1 = v2_modal2;\nv2_freq3 = 470 + r * 0.012;\nv2_rad3 = exp(-3.141592653589793 * v2_freq3 / (1.05 * samplerate));\nv2_modal3 = (1 - v2_rad3) * v2_exc_diff + 2 * v2_rad3 * cos(6.283185307179586 * v2_freq3 / samplerate) * v2_m3_1 - v2_rad3 * v2_rad3 * v2_m3_2;\nv2_m3_2 = v2_m3_1;\nv2_m3_1 = v2_modal3;\nv2_exc_2 = v2_exc_1;\nv2_exc_1 = v2_pressure;\nv2_body = (v2_modal0 * 1.65 + v2_modal1 * 0.95) * running_body * (0.45 + body * 0.65) * (1 + v2_body_env * 0.48 + v2_lift * release_mass * 0.30);\nv2_cavity = (v2_modal2 * 1.20 + v2_modal3 * 0.75) * running_cavity * (0.46 + v2_load_fast * 0.42 + intake_detail * v2_pedal * 0.22);\nv2_bank_order = cos(phase_l * 6.283185307179586) * (0.075 + body * 0.045) + cos(phase_l * 12.566370614359172) * (0.060 + texture * 0.022);\nv2_exhaust = v2_bank_order * exhaust_detail * (0.18 + v2_body_env * 0.13 + v2_lift * release_mass * 0.18);\nv2_center = v2_body + v2_cavity + v2_bank_order + v2_exhaust + v2_pressure * 0.24;\n// Retain a controlled mechanical gloss; fixed noninteger sine pairs no longer\n// dominate acceleration. This is intrinsic pulse structure, not a noise bed.\nv2_gloss = cos(phase_l * 37.69911184307752) * air_detail * brightness * v2_edge_env * 0.016;\nv2_old_edge_l = (bright_l + intake_l * 0.35 + residual_l * 0.28) * (1 - hf_softness * 0.94) * (0.06 + v2_edge_env * 0.18);\nv2_old_edge_r = (bright_r + intake_r * 0.35 + residual_r * 0.28) * (1 - hf_softness * 0.94) * (0.06 + v2_edge_env * 0.18);\nv2_side_raw = bank_side * (0.12 + texture * 0.10);\nv2_side_k = exp(-6.283185307179586 * 120 / samplerate);\nv2_side_low = v2_side_raw * (1 - v2_side_k) + v2_side_low * v2_side_k;\nv2_side = (v2_side_raw - v2_side_low) * stereo_width;\nv2_l_raw = v2_center + v2_side + v2_gloss + v2_old_edge_l;\nv2_r_raw = v2_center - v2_side + v2_gloss + v2_old_edge_r;\nv2_ceiling = 950 + brightness * 1450 + v2_edge_env * 320;\nv2_hf_k = exp(-6.283185307179586 * v2_ceiling / samplerate);\nv2_hf_l1 = v2_l_raw * (1 - v2_hf_k) + v2_hf_l1 * v2_hf_k;\nv2_hf_l2 = v2_hf_l1 * (1 - v2_hf_k) + v2_hf_l2 * v2_hf_k;\nv2_hf_r1 = v2_r_raw * (1 - v2_hf_k) + v2_hf_r1 * v2_hf_k;\nv2_hf_r2 = v2_hf_r1 * (1 - v2_hf_k) + v2_hf_r2 * v2_hf_k;\nv2_left = (v2_l_raw + hf_softness * (v2_hf_l2 - v2_l_raw)) * a * (0.90 + aggression * 0.10) + idle_center + idle_side;\nv2_right = (v2_r_raw + hf_softness * (v2_hf_r2 - v2_r_raw)) * a * (0.90 + aggression * 0.10) + idle_center - idle_side;\nlegacy_l = tanh(left_drive * sat_drive) / sat_drive;\nlegacy_r = tanh(right_drive * sat_drive) / sat_drive;\nv2_out_l = tanh(v2_left * sat_drive) / sat_drive;\nv2_out_r = tanh(v2_right * sat_drive) / sat_drive;\nout1 = legacy_l + v2_blend * (v2_out_l - legacy_l);\nout2 = legacy_r + v2_blend * (v2_out_r - legacy_r);",
